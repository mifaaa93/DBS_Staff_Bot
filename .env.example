# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=

# ID супергруппы (отрицательное число, напр. -1001234567890)
GROUP_ID=-100

# message_thread_id топиков внутри группы.
# Подсказать ID поможет дебаг-логирование бота: напишите в нужный топик —
# бот залогирует chat.id и message_thread_id.
TOPIC_TRASH_ID=
TOPIC_SOCIAL_ID=
TOPIC_GENERAL_ID=

# ID админов (кто может добавлять/удалять сотрудников), через запятую
ADMIN_IDS=

# --- Прочее ---
# Часовой пояс для расписания
TIMEZONE=Europe/Prague

# Строка подключения к БД
DATABASE_URL=sqlite:///dbs_bot.db
